# ==========================================
# GreenOps environment variables
# Used by the CLI, agents, dashboard and GitHub webhook listener.
# Copy to .env (or .env.local) and fill in only what you need.
# Values already set in the shell are never overwritten.
# ==========================================

# --- Model provider -------------------------------------------------------
# Google Gemini is the model provider for this project.
# Use --provider offline only for the deterministic, no-key judge walkthrough.
GREENOPS_LLM_PROVIDER=gemini

# Google Gemini (also used by the dashboard's Live Gemini cache demo)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
# GOOGLE_API_KEY=                 # alias, used when GEMINI_API_KEY is unset
# GEMINI_ENDPOINT=                # optional OpenAI-compatible endpoint override

# --- Ledger -----------------------------------------------------------------
# Dashboard: pin a ledger file (relative to the website folder). If unset, the
# newest of the known ledger filenames in the repo root/website is used.
# GitHub listener: where PR reviews are recorded (default greenops-ledger.json).
# GREENOPS_LEDGER_PATH=../../../greenops-fleet-ledger.json

# --- GitHub webhook listener (`greenops serve`) -----------------------------
# HMAC secret configured in the GitHub App webhook settings. Required: requests
# are rejected when it is missing.
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Token with pull_requests:write, checks:write, contents:read
GITHUB_TOKEN=ghp_your_github_token_here

# Optional GitHub App authentication
GITHUB_APP_ID=123456
# Path to the private key file (relative paths resolve from this file's folder)
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.private-key.pem
# ...or the key inline instead of a path:
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Listener port when not started through the CLI. `greenops serve` uses
# --port instead (default 3000).
# PORT=3000
